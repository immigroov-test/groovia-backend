# Copy this file to .env and fill in real values. .env is gitignored.
# Required for the backend to boot - config.py will exit if any are missing.

# LLM + search providers
GROQ_API_KEY=
TAVILY_API_KEY=

# Supabase - get these from your Supabase project's API settings page.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Supabase Postgres connection string.
# Local dev: direct URL is fine.
# Prod (Render): use the Transaction Pooler URL (port 6543), not the direct one.
# Either DATABASE_URL or SUPABASE_DB_URL works - config.py checks both.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# CORS - comma-separated list of allowed frontend origins.
# Dev:  http://localhost:3000
# Prod: https://your-vercel-domain.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Where the frontend lives - used to build "browse mentors" links in LLM responses.
FRONTEND_URL=http://localhost:3000

# Resend transactional email (in-house mailer). Optional - booking still works
# without it; emails are just skipped. Get a key at https://resend.com
RESEND_API_KEY=
# EMAIL_FROM=Immigroov <noreply@immigroov.com>
# Ops inbox copied on every booking / reschedule / cancellation (leave blank to disable).
ADMIN_EMAIL=

# BUG-026: signing secret for the Supabase Auth "Send Email" hook (Dashboard -> Authentication ->
# Hooks -> Send Email -> point it at POST {this backend}/auth/email-hook and copy the secret it
# shows you here). Without this, sign-in/signup/recovery emails still come from Supabase's own
# sender instead of EMAIL_FROM above.
SUPABASE_AUTH_HOOK_SECRET=

# Encrypts mentor payout bank details at rest (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, mentors can't submit/view bank details. Keep it secret; back it up (losing it
# makes stored details unrecoverable). Comma-separate multiple keys to rotate.
BANK_ENC_KEY=

# Optional: render the LangGraph PNG on startup (dev convenience only).
# DRAW_GRAPH=true

# ── Local dev mocks ────────────────────────────────────────────────────────────
# When true, intercepts Resend emails (writes them to _dev_emails.jsonl, readable
# via GET /dev/emails) so no real mail is sent. NEVER set this in production.
# MOCK_SERVICES=true

# ── Bug board (BUG-162) ───────────────────────────────────────────────────────
# The Immigroov bug board (github.com/sg19chess-spec/immigroov-bug-board) is a SEPARATE Supabase
# project, surfaced read/write on the admin dashboard's "Bug board" tab.
#
# The ANON key is the right one here, not the service role: that project's RLS already grants anon
# full access to the bugs table (its sql/004_rls_policies.sql), so nothing needs to bypass it, and
# a second project's service-role key has no business sitting in this environment.
#
# Both unset = the tab shows "not connected" and nothing else changes.
BUG_BOARD_SUPABASE_URL=
BUG_BOARD_SUPABASE_ANON_KEY=
